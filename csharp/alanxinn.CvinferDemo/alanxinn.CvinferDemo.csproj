<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>alanxinn</RootNamespace>
    <AssemblyName>alanxinn.CvinferDemo</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- Keep the RID for NuGet runtime asset selection, but use the standard
         bin\<Configuration>\net8.0-windows output directory. -->
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <UseLocalDenglinProject Condition="'$(UseLocalDenglinProject)' == ''">false</UseLocalDenglinProject>
    <UseLocalTensorRtProject Condition="'$(UseLocalTensorRtProject)' == '' and '$(UseLocalDenglinProject)' != 'true'">true</UseLocalTensorRtProject>
    <CvinferSharpPackageId Condition="'$(CvinferSharpPackageId)' == ''">alanxinn.CvinferSharp.TensorRT10</CvinferSharpPackageId>
    <CvinferSharpPackageVersion Condition="'$(CvinferSharpPackageVersion)' == ''">0.2.1</CvinferSharpPackageVersion>
    <CvinferSharpDenglinPackageId Condition="'$(CvinferSharpDenglinPackageId)' == ''">alanxinn.CvinferSharp.Denglin</CvinferSharpDenglinPackageId>
    <CvinferSharpDenglinPackageVersion Condition="'$(CvinferSharpDenglinPackageVersion)' == ''">0.1.4</CvinferSharpDenglinPackageVersion>
    <RestoreAdditionalProjectSources>$(MSBuildProjectDirectory)\..\..\package\TensorRT10;$(MSBuildProjectDirectory)\..\alanxinn.CvinferSharp\bin\TensorRT\Release;$(MSBuildProjectDirectory)\..\alanxinn.CvinferSharp\bin\Denglin</RestoreAdditionalProjectSources>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="$(CvinferSharpPackageId)" Version="$(CvinferSharpPackageVersion)"
                      Condition="'$(UseLocalDenglinProject)' != 'true' and '$(UseLocalTensorRtProject)' != 'true'" />
    <PackageReference Include="$(CvinferSharpDenglinPackageId)" Version="$(CvinferSharpDenglinPackageVersion)"
                      Condition="'$(UseLocalDenglinProject)' != 'true' and '$(UseLocalTensorRtProject)' != 'true'" />
    <ProjectReference Include="..\alanxinn.CvinferSharp\alanxinn.CvinferSharp.csproj"
                      Condition="'$(UseLocalTensorRtProject)' == 'true'" />
    <ProjectReference Include="..\alanxinn.CvinferSharp\alanxinn.CvinferSharp.Denglin.csproj"
                      Condition="'$(UseLocalDenglinProject)' == 'true'" />
    <PackageReference Include="OpenCvSharp4.Windows" Version="4.13.0.20260627" />
  </ItemGroup>
  <Target Name="CopyLocalTensorRtRuntime" AfterTargets="Build" Condition="'$(UseLocalTensorRtProject)' == 'true'">
    <ItemGroup>
      <LocalTensorRtRuntime Include="$(MSBuildProjectDirectory)\..\..\build\trt10-release\bin\alanxinn_cvinfer_trt.dll" />
      <LocalTensorRtRuntime Include="$(MSBuildProjectDirectory)\..\..\build\trt10-release\bin\alanxinn_cvinfer_sam3.dll" />
      <LocalTensorRtRuntime Include="$(MSBuildProjectDirectory)\..\..\build\trt10-release\bin\alanxinn_cvinfer_dinov3.dll" Condition="Exists('$(MSBuildProjectDirectory)\..\..\build\trt10-release\bin\alanxinn_cvinfer_dinov3.dll')" />
      <LocalTensorRtRuntime Include="$(MSBuildProjectDirectory)\..\..\build\trt10-release\bintrt\*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(LocalTensorRtRuntime)" DestinationFolder="$(OutDir)runtimes\win-x64\native" />
  </Target>
</Project>
