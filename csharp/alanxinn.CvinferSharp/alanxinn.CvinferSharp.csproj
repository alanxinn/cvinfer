<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net472;net6.0;net8.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <RootNamespace>alanxinn</RootNamespace>
    <AssemblyName>alanxinn.CvinferSharp</AssemblyName>
    <PackageId>alanxinn.CvinferSharp.TensorRT10</PackageId>

    <Version>0.2.0</Version>
    <AssemblyVersion>0.2.0.0</AssemblyVersion>
    <FileVersion>0.2.0.0</FileVersion>
    <InformationalVersion>0.2.0</InformationalVersion>

    <Authors>alanxinn</Authors>
    <Company>alanxinn</Company>
    <Product>alanxinn CvinferSharp</Product>

    <Description>.NET C# wrapper for the TensorRT native inference DLL.</Description>
    <AssemblyTitle>alanxinn.CvinferSharp</AssemblyTitle>
    <AssemblyDescription>C# managed wrapper for the TensorRT native inference API.</AssemblyDescription>

    <PackageTags>TensorRT;YOLO11;RF-DETR;SAM2.1;SAM3;DINOv3;MediaPipe;hands;features;pose;segmentation;CUDA;inference;CSharp;PInvoke</PackageTags>
    <PackageReleaseNotes>Standalone Windows x64 inference package with TensorRT10/CUDA12 and MSVC runtime embedded; RTX30/40/50, YOLO/RF-DETR, SAM2.1, SAM3, DINOv3 and MediaPipe hands.</PackageReleaseNotes>

    <PackageProjectUrl>https://github.com/alanxinn/cvinfer</PackageProjectUrl>
    <RepositoryUrl>https://github.com/alanxinn/cvinfer.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <PlatformTarget>x64</PlatformTarget>

    <NativeRuntimeSource Condition="'$(NativeRuntimeSource)' == '' and Exists('$(MSBuildProjectDirectory)\..\..\build\trt10-release\bin\alanxinn_cvinfer_trt.dll')">$(MSBuildProjectDirectory)\..\..\build\trt10-release\bin</NativeRuntimeSource>
    <NativeRuntimeSource Condition="'$(NativeRuntimeSource)' == '' and Exists('$(MSBuildProjectDirectory)\..\..\build-denglin\bin\$(Configuration)\alanxinn_cvinfer_trt.dll')">$(MSBuildProjectDirectory)\..\..\build-denglin\bin\$(Configuration)</NativeRuntimeSource>
    <NativeRuntimeSource Condition="'$(NativeRuntimeSource)' == ''">$(MSBuildProjectDirectory)\..\..\build\ninja-msvc-release\bin</NativeRuntimeSource>
    <NativeTrtRuntimeSource Condition="'$(NativeTrtRuntimeSource)' == '' and Exists('$(NativeRuntimeSource)\..\bintrt\nvinfer_10.dll')">$(NativeRuntimeSource)\..\bintrt</NativeTrtRuntimeSource>
    <NativeTrtRuntimeSource Condition="'$(NativeTrtRuntimeSource)' == ''">$(NativeRuntimeSource)</NativeTrtRuntimeSource>
    <NativeRuntimeDestination Condition="'$(NativeRuntimeDestination)' == ''">$(MSBuildProjectDirectory)\native\win-x64</NativeRuntimeDestination>
    <NativeCvinferLibraryName>alanxinn_cvinfer_trt.dll</NativeCvinferLibraryName>
    <BundleTensorRtRuntime Condition="'$(BundleTensorRtRuntime)' == ''">false</BundleTensorRtRuntime>
    <CoreRuntimePackage Condition="'$(CoreRuntimePackage)' == ''">$(MSBuildProjectDirectory)\..\..\package\TensorRT10\alanxinn.TensorRtRuntime.Core.TensorRT10.$(Version).nupkg</CoreRuntimePackage>
    <CoreRuntimeExtractionDirectory>$(MSBuildProjectDirectory)\obj\TensorRTCore\$(Version)</CoreRuntimeExtractionDirectory>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="README.md" />
    <None Remove="alanxinn.CvinferSharp.targets" />

    <None Include="README.md"
          Pack="true"
          PackagePath="README.md" />

    <None Include="alanxinn.CvinferSharp.targets"
          Pack="true"
          PackagePath="buildTransitive\alanxinn.CvinferSharp.TensorRT10.targets"
          Visible="false" />

    <None Include="..\..\LICENSE.txt"
          Pack="true"
          PackagePath="LICENSE.txt"
          Visible="false" />
  </ItemGroup>

  <Target Name="ValidatePackageLicenseFile"
          BeforeTargets="Pack;GenerateNuspec">
    <Error Text="Use scripts/Pack-Trt10.ps1 to pack the embedded TensorRT runtime."
           Condition="'$(BundleTensorRtRuntime)' != 'true'" />
    <Error Text="LICENSE.txt was not found. Expected path: $(MSBuildProjectDirectory)\..\..\LICENSE.txt"
           Condition="!Exists('$(MSBuildProjectDirectory)\..\..\LICENSE.txt')" />
  </Target>

  <Target Name="PrepareBundledCoreRuntime"
          Condition="'$(BundleTensorRtRuntime)' == 'true' and '$(TargetFramework)' == 'net8.0'">
    <Error Text="Core runtime package is missing: $(CoreRuntimePackage). Run scripts/Pack-Trt10.ps1 first."
           Condition="!Exists('$(CoreRuntimePackage)')" />
    <Unzip SourceFiles="$(CoreRuntimePackage)" DestinationFolder="$(CoreRuntimeExtractionDirectory)" SkipUnchangedFiles="false" />
    <ItemGroup>
      <RequiredEmbeddedCoreFiles Include="nvinfer_10.dll;nvinfer_plugin_10.dll;cudart64_12.dll;msvcp140.dll;vcruntime140.dll;vcruntime140_1.dll;tensorrt10-runtime.tsv" />
    </ItemGroup>
    <Error Text="Core runtime package is incomplete: %(RequiredEmbeddedCoreFiles.Identity)"
           Condition="!Exists('$(CoreRuntimeExtractionDirectory)\runtimes\win-x64\native\%(RequiredEmbeddedCoreFiles.Identity)')" />
  </Target>

  <Target Name="CopyAlanxinnNativeRuntime"
          DependsOnTargets="PrepareBundledCoreRuntime"
          BeforeTargets="Build;Pack"
          Condition="'$(TargetFramework)' == 'net8.0'">
    <ItemGroup>
      <AlanxinnNativeRuntimeFiles Include="$(NativeRuntimeSource)\$(NativeCvinferLibraryName)"
                                  Condition="Exists('$(NativeRuntimeSource)\$(NativeCvinferLibraryName)')" />
      <AlanxinnNativeRuntimeFiles Include="$(NativeRuntimeSource)\alanxinn_cvinfer_sam3.dll" Condition="Exists('$(NativeRuntimeSource)\alanxinn_cvinfer_sam3.dll')" />
      <AlanxinnNativeRuntimeFiles Include="$(NativeRuntimeSource)\alanxinn_cvinfer_sam2.dll" Condition="Exists('$(NativeRuntimeSource)\alanxinn_cvinfer_sam2.dll')" />
      <AlanxinnNativeRuntimeFiles Include="$(NativeRuntimeSource)\alanxinn_cvinfer_dinov3.dll" Condition="Exists('$(NativeRuntimeSource)\alanxinn_cvinfer_dinov3.dll')" />
      <AlanxinnNativeRuntimeFiles Include="$(NativeRuntimeSource)\alanxinn_cvinfer_mediapipe.dll" Condition="Exists('$(NativeRuntimeSource)\alanxinn_cvinfer_mediapipe.dll')" />
      <AlanxinnNativeRuntimeFiles Include="$(NativeTrtRuntimeSource)\opencv_world*.dll" />
      <AlanxinnNativeRuntimeFiles Include="$(CoreRuntimeExtractionDirectory)\runtimes\win-x64\native\nvinfer_10.dll;$(CoreRuntimeExtractionDirectory)\runtimes\win-x64\native\nvinfer_plugin_10.dll;$(CoreRuntimeExtractionDirectory)\runtimes\win-x64\native\cudart64_12.dll;$(CoreRuntimeExtractionDirectory)\runtimes\win-x64\native\msvcp140*.dll;$(CoreRuntimeExtractionDirectory)\runtimes\win-x64\native\vcruntime140*.dll;$(CoreRuntimeExtractionDirectory)\runtimes\win-x64\native\vccorlib140.dll;$(CoreRuntimeExtractionDirectory)\runtimes\win-x64\native\concrt140.dll;$(CoreRuntimeExtractionDirectory)\runtimes\win-x64\native\tensorrt10-runtime.tsv"
                                  Condition="'$(BundleTensorRtRuntime)' == 'true'" />
      <AlanxinnNativeRuntimeFiles Remove="$(NativeTrtRuntimeSource)\cudart64_*d.dll" />
      <AlanxinnNativeRuntimeFiles Remove="$(NativeTrtRuntimeSource)\opencv_world*d.dll" />

      <AlanxinnNativeStaleFiles Include="$(NativeRuntimeDestination)\alanxinn_cvinfer*.dll" />
      <AlanxinnNativeStaleFiles Include="$(NativeRuntimeDestination)\nvinfer*.dll" />
      <AlanxinnNativeStaleFiles Include="$(NativeRuntimeDestination)\nvonnxparser*.dll" />
      <AlanxinnNativeStaleFiles Include="$(NativeRuntimeDestination)\cudart64_*.dll" />
      <AlanxinnNativeStaleFiles Include="$(NativeRuntimeDestination)\cublas64_*.dll" />
      <AlanxinnNativeStaleFiles Include="$(NativeRuntimeDestination)\cublasLt64_*.dll" />
      <AlanxinnNativeStaleFiles Include="$(NativeRuntimeDestination)\cudnn*.dll" />
      <AlanxinnNativeStaleFiles Include="$(NativeRuntimeDestination)\nvrtc64_*.dll" />
      <AlanxinnNativeStaleFiles Include="$(NativeRuntimeDestination)\nvrtc-builtins64_*.dll" />
      <AlanxinnNativeStaleFiles Include="$(NativeRuntimeDestination)\zlibwapi.dll" />
      <AlanxinnNativeStaleFiles Include="$(NativeRuntimeDestination)\opencv_world*.dll" />
      <AlanxinnNativeStaleFiles Include="$(NativeRuntimeDestination)\msvcp140*.dll;$(NativeRuntimeDestination)\vcruntime140*.dll;$(NativeRuntimeDestination)\vccorlib140.dll;$(NativeRuntimeDestination)\concrt140.dll;$(NativeRuntimeDestination)\tensorrt10-runtime.tsv" />
    </ItemGroup>

    <Delete Files="@(AlanxinnNativeStaleFiles)"
            Condition="'@(AlanxinnNativeStaleFiles)' != ''" />

    <MakeDir Directories="$(NativeRuntimeDestination)"
             Condition="'@(AlanxinnNativeRuntimeFiles)' != ''" />

    <Copy SourceFiles="@(AlanxinnNativeRuntimeFiles)"
          DestinationFolder="$(NativeRuntimeDestination)"
          SkipUnchangedFiles="true"
          Condition="'@(AlanxinnNativeRuntimeFiles)' != ''" />


    <Message Importance="High"
             Text="Native runtime DLLs selected: @(AlanxinnNativeRuntimeFiles)"
             Condition="'@(AlanxinnNativeRuntimeFiles)' != ''" />
    <Message Importance="High" Text="Public NuGet excludes all private GPU preprocessing/postprocessing DLLs." />
  </Target>

  <PropertyGroup>
    <TargetsForTfmSpecificContentInPackage>
      $(TargetsForTfmSpecificContentInPackage);PackAlanxinnNativeRuntime
    </TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <Target Name="PackAlanxinnNativeRuntime"
          DependsOnTargets="ValidateAlanxinnNativeRuntime;CopyAlanxinnNativeRuntime"
          Condition="'$(TargetFramework)' == 'net8.0'">
    <ItemGroup>
      <AlanxinnNativePackageFiles Include="$(NativeRuntimeDestination)\$(NativeCvinferLibraryName)"
                                  Condition="Exists('$(NativeRuntimeDestination)\$(NativeCvinferLibraryName)')" />
      <AlanxinnNativePackageFiles Include="$(NativeRuntimeDestination)\alanxinn_cvinfer_sam3.dll" Condition="Exists('$(NativeRuntimeDestination)\alanxinn_cvinfer_sam3.dll')" />
      <AlanxinnNativePackageFiles Include="$(NativeRuntimeDestination)\alanxinn_cvinfer_sam2.dll" Condition="Exists('$(NativeRuntimeDestination)\alanxinn_cvinfer_sam2.dll')" />
      <AlanxinnNativePackageFiles Include="$(NativeRuntimeDestination)\alanxinn_cvinfer_dinov3.dll" Condition="Exists('$(NativeRuntimeDestination)\alanxinn_cvinfer_dinov3.dll')" />
      <AlanxinnNativePackageFiles Include="$(NativeRuntimeDestination)\alanxinn_cvinfer_mediapipe.dll" Condition="Exists('$(NativeRuntimeDestination)\alanxinn_cvinfer_mediapipe.dll')" />
      <AlanxinnNativePackageFiles Include="$(NativeRuntimeDestination)\opencv_world*.dll" />
      <AlanxinnNativePackageFiles Include="$(NativeRuntimeDestination)\nvinfer_10.dll;$(NativeRuntimeDestination)\nvinfer_plugin_10.dll;$(NativeRuntimeDestination)\cudart64_12.dll;$(NativeRuntimeDestination)\msvcp140*.dll;$(NativeRuntimeDestination)\vcruntime140*.dll;$(NativeRuntimeDestination)\vccorlib140.dll;$(NativeRuntimeDestination)\concrt140.dll;$(NativeRuntimeDestination)\tensorrt10-runtime.tsv"
                                  Condition="'$(BundleTensorRtRuntime)' == 'true'" />
      <AlanxinnNativePackageFiles Remove="$(NativeRuntimeDestination)\cudart64_*d.dll" />
      <AlanxinnNativePackageFiles Remove="$(NativeRuntimeDestination)\opencv_world*d.dll" />

      <TfmSpecificPackageFile Include="@(AlanxinnNativePackageFiles)"
                              Condition="Exists('$(NativeRuntimeDestination)')">
        <PackagePath>runtimes\win-x64\native\%(Filename)%(Extension)</PackagePath>
      </TfmSpecificPackageFile>
    </ItemGroup>

    <Message Importance="High"
             Text="NuGet native DLLs: @(AlanxinnNativePackageFiles)"
             Condition="'@(AlanxinnNativePackageFiles)' != ''" />
    <Message Importance="High"
             Text="NuGet native package path: runtimes\win-x64\native\%(AlanxinnNativePackageFiles.Filename)%(AlanxinnNativePackageFiles.Extension)"
             Condition="'@(AlanxinnNativePackageFiles)' != ''" />
  </Target>

  <Target Name="ValidateAlanxinnNativeRuntime"
          BeforeTargets="Pack"
          Condition="'$(TargetFramework)' == 'net8.0'">
    <Error Text="$(NativeCvinferLibraryName) was not found in '$(NativeRuntimeSource)'. Build the TensorRT C++ runtime before packing the NuGet package."
           Condition="!Exists('$(NativeRuntimeSource)\$(NativeCvinferLibraryName)')" />
    <Error Text="alanxinn_cvinfer_sam2.dll was not found. Build with BUILD_SAM2=ON before packing."
           Condition="!Exists('$(NativeRuntimeSource)\alanxinn_cvinfer_sam2.dll')" />
    <Error Text="alanxinn_cvinfer_mediapipe.dll was not found. Build with BUILD_MEDIAPIPE_HANDS=ON before packing."
           Condition="!Exists('$(NativeRuntimeSource)\alanxinn_cvinfer_mediapipe.dll')" />
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\tools\Assert-PublicNativeRuntime.ps1&quot; -Path &quot;$(NativeRuntimeSource)\$(NativeCvinferLibraryName)&quot;" />
  </Target>
</Project>
