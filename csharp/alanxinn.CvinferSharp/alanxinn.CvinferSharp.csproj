<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net472;net6.0;net8.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <RootNamespace>alanxinn</RootNamespace>
    <AssemblyName>alanxinn.CvinferSharp</AssemblyName>
    <PackageId>alanxinn.CvinferSharp</PackageId>

    <Version>0.1.4</Version>
    <AssemblyVersion>0.1.4.0</AssemblyVersion>
    <FileVersion>0.1.4.0</FileVersion>
    <InformationalVersion>0.1.4</InformationalVersion>

    <Authors>alanxinn</Authors>
    <Company>alanxinn</Company>
    <Product>alanxinn CvinferSharp</Product>

    <Description>.NET C# wrapper for the TensorRT native inference DLL.</Description>
    <AssemblyTitle>alanxinn.CvinferSharp</AssemblyTitle>
    <AssemblyDescription>C# managed wrapper for the TensorRT native inference API.</AssemblyDescription>

    <PackageTags>TensorRT;YOLO11;RF-DETR;pose;segmentation;CUDA;inference;CSharp;PInvoke</PackageTags>
    <PackageReleaseNotes>YOLO11/RF-DETR detection, segmentation and pose inference.</PackageReleaseNotes>

    <PackageProjectUrl>https://github.com/alanxinn/cvinfer</PackageProjectUrl>
    <RepositoryUrl>https://github.com/alanxinn/cvinfer.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <PlatformTarget>x64</PlatformTarget>

    <NativeRuntimeSource Condition="'$(NativeRuntimeSource)' == '' and Exists('$(MSBuildProjectDirectory)\..\..\build\ninja-msvc-private-cuda-release\bin\alanxinn_cvinfer_trt.dll')">$(MSBuildProjectDirectory)\..\..\build\ninja-msvc-private-cuda-release\bin</NativeRuntimeSource>
    <NativeRuntimeSource Condition="'$(NativeRuntimeSource)' == '' and Exists('$(MSBuildProjectDirectory)\..\..\build-denglin\bin\$(Configuration)\alanxinn_cvinfer_trt.dll')">$(MSBuildProjectDirectory)\..\..\build-denglin\bin\$(Configuration)</NativeRuntimeSource>
    <NativeRuntimeSource Condition="'$(NativeRuntimeSource)' == ''">$(MSBuildProjectDirectory)\..\..\build\ninja-msvc-release\bin</NativeRuntimeSource>
    <NativeTrtRuntimeSource Condition="'$(NativeTrtRuntimeSource)' == '' and Exists('$(NativeRuntimeSource)\..\bintrt\nvinfer.dll')">$(NativeRuntimeSource)\..\bintrt</NativeTrtRuntimeSource>
    <NativeTrtRuntimeSource Condition="'$(NativeTrtRuntimeSource)' == ''">$(NativeRuntimeSource)</NativeTrtRuntimeSource>
    <NativeRuntimeDestination Condition="'$(NativeRuntimeDestination)' == ''">$(MSBuildProjectDirectory)\native\win-x64</NativeRuntimeDestination>
    <NativeCvinferLibraryName>alanxinn_cvinfer_trt.dll</NativeCvinferLibraryName>
    <AlanxinnCudaBackendFile>$(NativeTrtRuntimeSource)\alanxinn_cvinfer_cuda.dll</AlanxinnCudaBackendFile>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="README.md" />
    <None Remove="alanxinn.CvinferSharp.targets" />

    <None Include="README.md"
          Pack="true"
          PackagePath="README.md" />

    <None Include="alanxinn.CvinferSharp.targets"
          Pack="true"
          PackagePath="buildTransitive\alanxinn.CvinferSharp.targets"
          Visible="false" />

    <None Include="..\..\LICENSE.txt"
          Pack="true"
          PackagePath="LICENSE.txt"
          Visible="false" />
  </ItemGroup>

  <Target Name="ValidatePackageLicenseFile"
          BeforeTargets="Pack">
    <Error Text="LICENSE.txt was not found. Expected path: $(MSBuildProjectDirectory)\..\..\LICENSE.txt"
           Condition="!Exists('$(MSBuildProjectDirectory)\..\..\LICENSE.txt')" />
  </Target>

  <Target Name="CopyAlanxinnNativeRuntime"
          BeforeTargets="Build;Pack"
          Condition="'$(TargetFramework)' == 'net8.0'">
    <ItemGroup>
      <AlanxinnNativeRuntimeFiles Include="$(NativeRuntimeSource)\$(NativeCvinferLibraryName)"
                                  Condition="Exists('$(NativeRuntimeSource)\$(NativeCvinferLibraryName)')" />
      <AlanxinnNativeRuntimeFiles Include="$(AlanxinnCudaBackendFile)"
                                  Condition="Exists('$(AlanxinnCudaBackendFile)')" />
      <AlanxinnNativeRuntimeFiles Include="$(NativeTrtRuntimeSource)\nvinfer.dll"
                                  Condition="Exists('$(NativeTrtRuntimeSource)\nvinfer.dll')" />
      <AlanxinnNativeRuntimeFiles Include="$(NativeTrtRuntimeSource)\cudart64_*.dll" />
      <AlanxinnNativeRuntimeFiles Include="$(NativeTrtRuntimeSource)\zlibwapi.dll"
                                  Condition="Exists('$(NativeTrtRuntimeSource)\zlibwapi.dll')" />
      <AlanxinnNativeRuntimeFiles Include="$(NativeTrtRuntimeSource)\opencv_world*.dll" />
      <AlanxinnNativeRuntimeFiles Remove="$(NativeTrtRuntimeSource)\cudart64_*d.dll" />
      <AlanxinnNativeRuntimeFiles Remove="$(NativeTrtRuntimeSource)\opencv_world*d.dll" />

      <AlanxinnNativeStaleFiles Include="$(NativeRuntimeDestination)\alanxinn_cvinfer*.dll" />
      <AlanxinnNativeStaleFiles Include="$(NativeRuntimeDestination)\nvinfer*.dll" />
      <AlanxinnNativeStaleFiles Include="$(NativeRuntimeDestination)\nvonnxparser*.dll" />
      <AlanxinnNativeStaleFiles Include="$(NativeRuntimeDestination)\cudart64_*.dll" />
      <AlanxinnNativeStaleFiles Include="$(NativeRuntimeDestination)\cublas64_*.dll" />
      <AlanxinnNativeStaleFiles Include="$(NativeRuntimeDestination)\cublasLt64_*.dll" />
      <AlanxinnNativeStaleFiles Include="$(NativeRuntimeDestination)\cudnn*.dll" />
      <AlanxinnNativeStaleFiles Include="$(NativeRuntimeDestination)\nvrtc64_*.dll" />
      <AlanxinnNativeStaleFiles Include="$(NativeRuntimeDestination)\nvrtc-builtins64_*.dll" />
      <AlanxinnNativeStaleFiles Include="$(NativeRuntimeDestination)\zlibwapi.dll" />
      <AlanxinnNativeStaleFiles Include="$(NativeRuntimeDestination)\opencv_world*.dll" />
    </ItemGroup>

    <Delete Files="@(AlanxinnNativeStaleFiles)"
            Condition="'@(AlanxinnNativeStaleFiles)' != ''" />

    <MakeDir Directories="$(NativeRuntimeDestination)"
             Condition="'@(AlanxinnNativeRuntimeFiles)' != ''" />

    <Copy SourceFiles="@(AlanxinnNativeRuntimeFiles)"
          DestinationFolder="$(NativeRuntimeDestination)"
          SkipUnchangedFiles="true"
          Condition="'@(AlanxinnNativeRuntimeFiles)' != ''" />


    <Message Importance="High"
             Text="Native runtime DLLs selected: @(AlanxinnNativeRuntimeFiles)"
             Condition="'@(AlanxinnNativeRuntimeFiles)' != ''" />
    <Message Importance="High"
             Text="CUDA backend enabled: $(AlanxinnCudaBackendFile)"
             Condition="Exists('$(AlanxinnCudaBackendFile)')" />
    <Message Importance="High"
             Text="CUDA backend skipped (DLL not found): $(AlanxinnCudaBackendFile)"
             Condition="!Exists('$(AlanxinnCudaBackendFile)')" />
  </Target>

  <PropertyGroup>
    <TargetsForTfmSpecificContentInPackage>
      $(TargetsForTfmSpecificContentInPackage);PackAlanxinnNativeRuntime
    </TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <Target Name="PackAlanxinnNativeRuntime"
          DependsOnTargets="CopyAlanxinnNativeRuntime"
          Condition="'$(TargetFramework)' == 'net8.0'">
    <ItemGroup>
      <AlanxinnNativePackageFiles Include="$(NativeRuntimeDestination)\$(NativeCvinferLibraryName)"
                                  Condition="Exists('$(NativeRuntimeDestination)\$(NativeCvinferLibraryName)')" />
      <AlanxinnNativePackageFiles Include="$(NativeRuntimeDestination)\alanxinn_cvinfer_cuda.dll"
                                  Condition="Exists('$(AlanxinnCudaBackendFile)') and Exists('$(NativeRuntimeDestination)\alanxinn_cvinfer_cuda.dll')" />
      <AlanxinnNativePackageFiles Include="$(NativeRuntimeDestination)\nvinfer.dll"
                                  Condition="Exists('$(NativeRuntimeDestination)\nvinfer.dll')" />
      <AlanxinnNativePackageFiles Include="$(NativeRuntimeDestination)\cudart64_*.dll" />
      <AlanxinnNativePackageFiles Include="$(NativeRuntimeDestination)\zlibwapi.dll"
                                  Condition="Exists('$(NativeRuntimeDestination)\zlibwapi.dll')" />
      <AlanxinnNativePackageFiles Include="$(NativeRuntimeDestination)\opencv_world*.dll" />
      <AlanxinnNativePackageFiles Remove="$(NativeRuntimeDestination)\cudart64_*d.dll" />
      <AlanxinnNativePackageFiles Remove="$(NativeRuntimeDestination)\opencv_world*d.dll" />

      <TfmSpecificPackageFile Include="@(AlanxinnNativePackageFiles)"
                              Condition="Exists('$(NativeRuntimeDestination)')">
        <PackagePath>runtimes\win-x64\native\%(Filename)%(Extension)</PackagePath>
      </TfmSpecificPackageFile>
    </ItemGroup>

    <Message Importance="High"
             Text="NuGet native DLLs: @(AlanxinnNativePackageFiles)"
             Condition="'@(AlanxinnNativePackageFiles)' != ''" />
    <Message Importance="High"
             Text="NuGet native package path: runtimes\win-x64\native\%(AlanxinnNativePackageFiles.Filename)%(AlanxinnNativePackageFiles.Extension)"
             Condition="'@(AlanxinnNativePackageFiles)' != ''" />
    <Message Importance="High"
             Text="NuGet CUDA backend: included"
             Condition="Exists('$(AlanxinnCudaBackendFile)') and Exists('$(NativeRuntimeDestination)\alanxinn_cvinfer_cuda.dll')" />
    <Message Importance="High"
             Text="NuGet CUDA backend: skipped"
             Condition="!Exists('$(AlanxinnCudaBackendFile)') or !Exists('$(NativeRuntimeDestination)\alanxinn_cvinfer_cuda.dll')" />
  </Target>

  <Target Name="ValidateAlanxinnNativeRuntime"
          BeforeTargets="Pack"
          Condition="'$(TargetFramework)' == 'net8.0'">
    <Error Text="$(NativeCvinferLibraryName) was not found in '$(NativeRuntimeSource)'. Build the TensorRT C++ runtime before packing the NuGet package."
           Condition="!Exists('$(NativeRuntimeSource)\$(NativeCvinferLibraryName)')" />
  </Target>
</Project>
