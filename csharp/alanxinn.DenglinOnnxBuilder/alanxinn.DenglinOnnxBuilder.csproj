<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net472;net6.0;net8.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>alanxinn.Denglin</RootNamespace>
    <AssemblyName>alanxinn.DenglinOnnxBuilder</AssemblyName>
    <PackageId>alanxinn.DenglinOnnxBuilder</PackageId>
    <Version>0.1.4</Version>
    <AssemblyVersion>0.1.4.0</AssemblyVersion>
    <FileVersion>0.1.4.0</FileVersion>
    <InformationalVersion>0.1.4</InformationalVersion>
    <Authors>alanxinn</Authors>
    <Company>alanxinn</Company>
    <Product>alanxinn DenglinOnnxBuilder</Product>
    <Description>Managed C# API that invokes Denglin nnexec to convert ONNX models to serialized engines.</Description>
    <PackageTags>Denglin;ONNX;engine;builder;CSharp;nnexec</PackageTags>
    <PackageReleaseNotes>ONNX metadata auto detection, nnexec engine serialization, and optional versioned Denglin SDK runtime download.</PackageReleaseNotes>
    <PackageProjectUrl>https://github.com/alanxinn/cvinfer</PackageProjectUrl>
    <RepositoryUrl>https://github.com/alanxinn/cvinfer.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <PlatformTarget>x64</PlatformTarget>
    <PackageOutputPath>$(MSBuildProjectDirectory)\bin\Denglin</PackageOutputPath>

  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.IO.Compression"
               Condition="'$(TargetFramework)' == 'net472'" />
    <Reference Include="System.IO.Compression.FileSystem"
               Condition="'$(TargetFramework)' == 'net472'" />
    <Reference Include="System.Net.Http"
               Condition="'$(TargetFramework)' == 'net472'" />
    <None Remove="README.md" />
    <None Include="README.md" Pack="true" PackagePath="README.md" />
    <None Include="alanxinn.DenglinOnnxBuilder.targets"
          Pack="true"
          PackagePath="buildTransitive\alanxinn.DenglinOnnxBuilder.targets"
          Visible="false" />
    <None Include="tools\Pack-DenglinRuntime.ps1"
          Pack="true"
          PackagePath="tools\Pack-DenglinRuntime.ps1" />
    <None Include="..\..\LICENSE.txt" Pack="true" PackagePath="LICENSE.txt" Visible="false" />
  </ItemGroup>

  <PropertyGroup>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);PackDenglinRuntimeBundle</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <!--
    SDK/Python are intentionally opt-in because they are large and may be
    subject to vendor redistribution terms. Set DenglinRuntimeBundleSource to
    a prepared sdk/ + python/ directory to create an offline-capable package.
  -->
  <Target Name="PackDenglinRuntimeBundle"
          Condition="'$(TargetFramework)' == 'net8.0' and '$(DenglinRuntimeBundleSource)' != ''">
    <ItemGroup>
      <DenglinRuntimeSdkFiles Include="$(DenglinRuntimeBundleSource)\sdk\**\*"
                               Condition="Exists('$(DenglinRuntimeBundleSource)\sdk')" />
      <DenglinRuntimePythonFiles Include="$(DenglinRuntimeBundleSource)\python\**\*"
                                 Condition="Exists('$(DenglinRuntimeBundleSource)\python')" />
      <TfmSpecificPackageFile Include="@(DenglinRuntimeSdkFiles)">
        <PackagePath>runtimes\win-x64\denglin\sdk\%(RecursiveDir)%(Filename)%(Extension)</PackagePath>
      </TfmSpecificPackageFile>
      <TfmSpecificPackageFile Include="@(DenglinRuntimePythonFiles)">
        <PackagePath>runtimes\win-x64\denglin\python\%(RecursiveDir)%(Filename)%(Extension)</PackagePath>
      </TfmSpecificPackageFile>
    </ItemGroup>
    <Message Importance="High"
             Text="Denglin SDK/Python runtime bundle enabled from '$(DenglinRuntimeBundleSource)'"
             Condition="'@(DenglinRuntimeSdkFiles);@(DenglinRuntimePythonFiles)' != ''" />
  </Target>

</Project>
