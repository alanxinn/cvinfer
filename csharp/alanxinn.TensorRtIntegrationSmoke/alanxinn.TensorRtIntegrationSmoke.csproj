<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\alanxinn.CvinferSharp\alanxinn.CvinferSharp.csproj" />
    <ProjectReference Include="..\alanxinn.TensorRtOnnxBuilder\alanxinn.TensorRtOnnxBuilder.csproj" />
  </ItemGroup>
  <Target Name="CopyNativeTestRuntime" AfterTargets="Build">
    <ItemGroup>
      <InferenceRuntime Include="$(MSBuildProjectDirectory)\..\..\build\trt10-release\bin\alanxinn_cvinfer_trt.dll" />
      <InferenceRuntime Include="$(MSBuildProjectDirectory)\..\..\build\trt10-release\bin\alanxinn_cvinfer_sam3.dll" />
      <InferenceRuntime Include="$(MSBuildProjectDirectory)\..\..\build\trt10-release\bintrt\*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(InferenceRuntime)" DestinationFolder="$(OutDir)runtimes\win-x64\native" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\..\..\build\trt10-release\tensorrt_builder\alanxinn_tensorrt_builder.dll"
          DestinationFolder="$(OutDir)" />
  </Target>
</Project>
