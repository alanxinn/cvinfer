<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>alanxinn.TensorRtOnnxBuilderDemo</RootNamespace>
    <AssemblyName>alanxinn.TensorRtOnnxBuilderDemo</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <UseLocalTensorRtProject Condition="'$(UseLocalTensorRtProject)' == ''">true</UseLocalTensorRtProject>
    <RestoreAdditionalProjectSources>$(MSBuildProjectDirectory)\..\..\package\TensorRT10;$(MSBuildProjectDirectory)\..\alanxinn.TensorRtOnnxBuilder\bin\Release</RestoreAdditionalProjectSources>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="alanxinn.TensorRtOnnxBuilder.TensorRT10" Version="0.2.0"
                      Condition="'$(UseLocalTensorRtProject)' != 'true'" />
    <ProjectReference Include="..\alanxinn.TensorRtOnnxBuilder\alanxinn.TensorRtOnnxBuilder.csproj"
                      Condition="'$(UseLocalTensorRtProject)' == 'true'" />
  </ItemGroup>
  <Target Name="CopyLocalTensorRtBuilder" AfterTargets="Build" Condition="'$(UseLocalTensorRtProject)' == 'true'">
    <Copy SourceFiles="$(MSBuildProjectDirectory)\..\..\build\trt10-release\tensorrt_builder\alanxinn_tensorrt_builder.dll"
          DestinationFolder="$(OutDir)" />
  </Target>
</Project>
